#!/usr/bin/env python3
"""Post a mid-task progress update into the Discord channel/thread the CURRENT
turn is running in — WITHOUT ending the turn.

The running turn's subprocess gets DISCORD_CHANNEL_ID in its env (set by
botcore/bot.py:run_streaming). This just queues the message to an outbox file;
the bot's _update_outbox_poller picks it up within a few seconds and sends it.

Usage:
    discord-update "Downloaded the data, now checking 2,300 rows…"
    echo "long status" | discord-update
"""
import os, sys, json, pathlib

if sys.argv[1:2] in (["-h"], ["--help"]):
    print(__doc__.strip())
    sys.exit(0)
text = " ".join(sys.argv[1:]).strip()
if not text and not sys.stdin.isatty():
    text = sys.stdin.read().strip()
if not text:
    sys.exit("discord-update: nothing to post")

chan = os.environ.get("DISCORD_CHANNEL_ID", "").strip()
if not chan:
    sys.exit("discord-update: DISCORD_CHANNEL_ID not set "
             "(only works inside a running bot turn)")

OUT = pathlib.Path(os.environ.get("BOT_HOME") or
                   pathlib.Path.home() / ".config" / "kit" / "discord-bot") / "state" / "update_outbox.jsonl"
with open(OUT, "a") as f:
    f.write(json.dumps({"channel_id": chan, "content": text}) + "\n")
print("discord-update: queued")
